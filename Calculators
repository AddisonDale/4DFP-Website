<script>
(function(){
  var nzd0=new Intl.NumberFormat('en-NZ',{style:'currency',currency:'NZD',maximumFractionDigits:0});
  var nzd2=new Intl.NumberFormat('en-NZ',{style:'currency',currency:'NZD',minimumFractionDigits:2,maximumFractionDigits:2});
  function num(id){var v=parseFloat(document.getElementById(id).value);return isFinite(v)&&v>=0?v:0;}
  function freqLabel(f){return f===52?'per week':(f===26?'per fortnight':'per month');}
  function pmt(P,annualPct,years,f){
    var n=Math.round(years*f);if(P<=0||n<=0)return 0;
    var r=annualPct/100/f;
    if(r===0)return P/n;
    return P*r/(1-Math.pow(1+r,-n));
  }
  function periodsToText(periods,f){
    var years=periods/f;
    var y=Math.floor(years);
    var mo=Math.round((years-y)*12);
    if(mo===12){y+=1;mo=0;}
    var out=[];
    if(y>0)out.push(y+(y===1?' year':' years'));
    if(mo>0)out.push(mo+(mo===1?' month':' months'));
    return out.length?out.join(', '):'under a month';
  }
  function on(ids,fn){ids.forEach(function(id){var el=document.getElementById(id);if(el)el.addEventListener('input',fn);});fn();}
  function setText(id,t){var el=document.getElementById(id);if(el)el.textContent=t;}
  function setAttr(id,attr,v){var el=document.getElementById(id);if(el)el.setAttribute(attr,v);}
  function shortNZD(v){if(v>=1e6)return '$'+(v/1e6).toFixed(v>=1e7?0:2).replace(/\.00$/,'')+'m';if(v>=1e3)return '$'+Math.round(v/1e3)+'k';return '$'+Math.round(v);}
  function setBar(barId,valId,value,max,maxW,fmt){
    var w=max>0?Math.max(0,Math.min(1,value/max))*maxW:0;
    setAttr(barId,'width',w.toFixed(1));
    var t=document.getElementById(valId);
    if(t){t.textContent=fmt(Math.max(0,value));t.setAttribute('x',(w>110?6:w+6).toFixed(0));t.setAttribute('fill',w>110?'#40242C':'#fff');}
  }

  /* ── 1. Loan repayments ── */
  on(['r-amount','r-rate','r-term','r-freq'],function(){
    var P=num('r-amount'),rate=num('r-rate'),yrs=num('r-term'),f=parseInt(document.getElementById('r-freq').value,10);
    var pay=pmt(P,rate,yrs,f),n=Math.round(yrs*f);
    setText('r-payment',nzd2.format(pay));
    setText('r-freq-label',freqLabel(f));
    setText('r-interest',nzd0.format(Math.max(0,pay*n-P)));
    setText('r-total',nzd0.format(pay*n));
    setText('r-stress',nzd2.format(pmt(P,rate+1,yrs,f))+' '+freqLabel(f));
    setText('r-io',nzd2.format(P*(rate/100)/f)+' '+freqLabel(f));
    var totalPaid=pay*n,share=totalPaid>0?Math.max(0,totalPaid-P)/totalPaid:0,C=2*Math.PI*45;
    setAttr('r-donut','stroke-dasharray',(share*C).toFixed(1)+' '+C.toFixed(1));
    setText('r-donut-pct',Math.round(share*100)+'%');
  });

  /* ── 2. Extra repayments ── */
  function simulate(P,rate,f,pay,lump){
    var r=rate/100/f;
    var bal=Math.max(0,P-lump);
    var interest=0,periods=0,cap=f*100;
    if(bal<=0)return{interest:0,periods:0,ok:true};
    if(r>0&&pay<=bal*r)return{ok:false};
    while(bal>0&&periods<cap){
      var i=bal*r;
      interest+=i;
      var principal=Math.min(pay-i,bal);
      bal-=principal;
      periods++;
    }
    return{interest:interest,periods:periods,ok:true};
  }
  function series(P,rate,f,pay,lump){
    var r=rate/100/f;
    var bal=Math.max(0,P-lump);
    var pts=[bal],periods=0,cap=f*100;
    if(bal<=0)return pts;
    if(r>0&&pay<=bal*r)return null;
    while(bal>0&&periods<cap){
      var i=bal*r;
      var principal=Math.min(pay-i,bal);
      bal-=principal;
      periods++;
      if(periods%f===0)pts.push(Math.max(0,bal));
    }
    if(pts[pts.length-1]>0)pts.push(0);
    return pts;
  }
  function drawLine(id,pts,maxY,maxYears){
    var el=document.getElementById(id);if(!el||!pts)return;
    var x0=36,x1=292,y0=126,y1=10;
    var str=pts.map(function(v,i){
      var x=x0+(maxYears>0?(i/maxYears):0)*(x1-x0);
      var y=y0-(maxY>0?(v/maxY):0)*(y0-y1);
      return x.toFixed(1)+','+y.toFixed(1);
    }).join(' ');
    el.setAttribute('points',str);
  }
  on(['e-amount','e-rate','e-term','e-freq','e-extra','e-lump'],function(){
    var P=num('e-amount'),rate=num('e-rate'),yrs=num('e-term'),f=parseInt(document.getElementById('e-freq').value,10);
    var extra=num('e-extra'),lump=num('e-lump');
    var base=pmt(P,rate,yrs,f),n=Math.round(yrs*f);
    var baseInterest=Math.max(0,base*n-P);
    var res=simulate(P,rate,f,base+extra,lump);
    if(!res.ok||base===0){
      setText('e-saved','—');setText('e-time','—');setText('e-payoff','—');setText('e-payments','—');
      setAttr('e-line-base','points','');setAttr('e-line-extra','points','');
      return;
    }
    setText('e-saved',nzd0.format(Math.max(0,baseInterest-res.interest)));
    setText('e-time',periodsToText(Math.max(0,n-res.periods),f));
    setText('e-payoff',periodsToText(res.periods,f));
    setText('e-payments',nzd2.format(base)+' → '+nzd2.format(base+extra)+' '+freqLabel(f));
    var sBase=series(P,rate,f,base,0),sExtra=series(P,rate,f,base+extra,lump);
    drawLine('e-line-base',sBase,P,yrs);
    drawLine('e-line-extra',sExtra,P,yrs);
    setText('e-x-max',Math.round(yrs)+' yrs');
    setText('e-y-max',shortNZD(P));
  });

  /* ── 3. Refix / refinance comparison ── */
  on(['f-amount','f-term','f-rate1','f-rate2','f-freq'],function(){
    var P=num('f-amount'),yrs=num('f-term'),f=parseInt(document.getElementById('f-freq').value,10);
    var r1=num('f-rate1'),r2=num('f-rate2');
    var p1=pmt(P,r1,yrs,f),p2=pmt(P,r2,yrs,f),n=Math.round(yrs*f);
    setText('f-pay1',nzd2.format(p1)+' '+freqLabel(f)+' at '+r1.toFixed(2)+'%');
    setText('f-pay2',nzd2.format(p2)+' '+freqLabel(f)+' at '+r2.toFixed(2)+'%');
    setText('f-diff',nzd2.format(Math.abs(p1-p2))+' '+freqLabel(f));
    setText('f-idiff',nzd0.format(Math.abs((p1*n)-(p2*n))));
    var i1=Math.max(0,p1*n-P),i2=Math.max(0,p2*n-P),imax=Math.max(i1,i2);
    setText('f-barlabel1','Rate A · '+r1.toFixed(2)+'%');
    setText('f-barlabel2','Rate B · '+r2.toFixed(2)+'%');
    setBar('f-bar1','f-barval1',i1,imax,300,function(v){return nzd0.format(v);});
    setBar('f-bar2','f-barval2',i2,imax,300,function(v){return nzd0.format(v);});
  });

  /* ── 4. Deposit & LVR ── */
  on(['l-price','l-deposit'],function(){
    var price=num('l-price'),dep=Math.min(num('l-deposit'),num('l-price'));
    var loan=Math.max(0,price-dep);
    var lvr=price>0?loan/price*100:0;
    var depPct=price>0?dep/price*100:0;
    setText('l-loan',nzd0.format(loan));
    setText('l-dep',nzd0.format(dep)+' ('+depPct.toFixed(1)+'%)');
    setText('l-lvr',lvr.toFixed(1)+'%');
    setAttr('l-bar','width',(Math.max(0,Math.min(100,lvr))/100*300).toFixed(1));
    var note;
    if(price<=0){note='Enter a property price to see your LVR.';}
    else if(lvr<=80){note='A deposit of 20% or more meets the level most banks prefer for existing homes, which generally opens up the widest range of lenders and rates.';}
    else if(lvr<=90){note='Under a 20% deposit is low-equity territory for most banks, and low-equity margins or premiums can apply. Options can still exist, including low-deposit and non-bank lending. Worth a conversation.';}
    else{note='Above 90% LVR, mainstream bank options narrow considerably. Depending on your situation there may still be paths worth exploring, so talk to us before ruling anything out.';}
    setText('l-note',note);
  });

  /* ── 5. Rental return ── */
  on(['y-price','y-rent','y-weeks','y-rates','y-ins','y-maint','y-mgmt','y-loan','y-rate'],function(){
    var price=num('y-price'),rent=num('y-rent'),weeks=Math.min(52,num('y-weeks'));
    var exp=num('y-rates')+num('y-ins')+num('y-maint');
    var mgmtPct=num('y-mgmt'),loan=num('y-loan'),rate=num('y-rate');
    var annualRent=rent*weeks;
    var mgmt=annualRent*mgmtPct/100;
    var totalExp=exp+mgmt;
    var netIncome=annualRent-totalExp;
    var grossYield=price>0?(rent*52)/price*100:0;
    var netYield=price>0?netIncome/price*100:0;
    var interest=loan*(rate/100);
    var cashflow=netIncome-interest;
    setText('y-gross',grossYield.toFixed(2)+'%');
    setText('y-net',netYield.toFixed(2)+'%');
    setText('y-netincome',nzd0.format(netIncome));
    setText('y-interest',nzd0.format(interest));
    var wk=cashflow/52;
    setText('y-cashflow',(wk<0?'−':'')+nzd0.format(Math.abs(wk))+' per week ('+(cashflow<0?'−':'')+nzd0.format(Math.abs(cashflow))+' per year)');
    var costs=totalExp+interest;
    var left=Math.max(0,annualRent-costs);
    var bmax=Math.max(annualRent,costs,1);
    setBar('y-bar1','y-barval1',annualRent,bmax,300,function(v){return nzd0.format(v);});
    setBar('y-bar2','y-barval2',costs,bmax,300,function(v){return nzd0.format(v);});
    setBar('y-bar3','y-barval3',left,bmax,300,function(v){return cashflow<0?'Shortfall of '+nzd0.format(Math.abs(cashflow)):nzd0.format(left);});
  });

  /* Phone link hooks — CONVERSION EVENT (Tuesday): fire gtag call-click conversion inside this handler */
  document.querySelectorAll('[data-tel]').forEach(function(a){
    a.addEventListener('click',function(){ /* gtag('event','call_click',...) */ });
  });
})();
</script>
