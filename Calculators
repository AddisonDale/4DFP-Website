    <!-- ═══════════ 1. LOAN REPAYMENT CALCULATOR ═══════════ -->
    <div id="repayments" style="margin-bottom:clamp(44px,5.5vw,72px);">
      <div style="max-width:680px;margin-bottom:22px;">
        <div style="font-size:12.5px;font-weight:600;letter-spacing:0.16em;text-transform:uppercase;color:#EF4130;margin-bottom:12px;">Calculator 01</div>
        <h2 style="font-weight:800;font-size:clamp(1.7rem,3vw,2.4rem);line-height:1.08;letter-spacing:-0.02em;color:#40242C;margin:0 0 10px;">Loan repayment calculator</h2>
        <p style="font-size:15.5px;line-height:1.6;color:#6E6258;margin:0;">What a loan costs per week, fortnight or month, the total interest over the term, and what happens if rates rise.</p>
      </div>
      <div class="calc-card">
        <div>
          <div class="calc-field"><label class="calc-label" for="r-amount">Loan amount ($)</label><input class="calc-input" type="number" id="r-amount" inputmode="decimal" min="0" step="1000" value="600000"></div>
          <div class="calc-field"><label class="calc-label" for="r-rate">Interest rate (% p.a.)</label><input class="calc-input" type="number" id="r-rate" inputmode="decimal" min="0" max="25" step="0.01" value="5.50"><p class="calc-hint">Use the rate you've been quoted or want to test. Rates change and vary by lender.</p></div>
          <div class="calc-field"><label class="calc-label" for="r-term">Loan term (years)</label><input class="calc-input" type="number" id="r-term" inputmode="numeric" min="1" max="35" step="1" value="30"></div>
          <div class="calc-field"><label class="calc-label" for="r-freq">Repayment frequency</label><select class="calc-input" id="r-freq"><option value="52">Weekly</option><option value="26" selected>Fortnightly</option><option value="12">Monthly</option></select></div>
        </div>
        <div class="result-panel">
          <div class="result-row"><p class="result-label">Repayment (principal &amp; interest)</p><p class="result-big"><span class="result-accent" id="r-payment">$0</span> <span style="font-size:1rem;font-weight:600;color:rgba(255,255,255,0.6);" id="r-freq-label">per fortnight</span></p></div>
          <div class="result-row"><p class="result-label">Total interest over the term</p><p class="result-mid" id="r-interest">$0</p></div>
          <div class="result-row"><p class="result-label">Total repaid over the term</p><p class="result-mid" id="r-total">$0</p></div>
          <div class="result-row"><p class="result-label">Stress test: repayment if rates rise 1%</p><p class="result-mid" id="r-stress">$0</p></div>
          <div class="result-row"><p class="result-label">Interest-only equivalent</p><p class="result-mid" id="r-io">$0</p></div>
          <div class="result-row">
            <p class="result-label">Where the money goes over the term</p>
            <svg viewBox="0 0 120 120" width="128" height="128" aria-hidden="true" style="display:block;margin:8px auto 4px;">
              <circle cx="60" cy="60" r="45" fill="none" stroke="#CDBCAF" stroke-width="16"></circle>
              <circle id="r-donut" cx="60" cy="60" r="45" fill="none" stroke="#EF4130" stroke-width="16" stroke-dasharray="0 283" transform="rotate(-90 60 60)"></circle>
              <text id="r-donut-pct" x="60" y="58" text-anchor="middle" fill="#fff" font-size="17" font-weight="800">0%</text>
              <text x="60" y="74" text-anchor="middle" fill="rgba(255,255,255,0.55)" font-size="8.5" font-weight="600" letter-spacing="0.08em">INTEREST</text>
            </svg>
            <div style="display:flex;justify-content:center;gap:18px;font-size:12px;color:rgba(255,255,255,0.7);">
              <span style="display:inline-flex;align-items:center;gap:6px;"><span style="width:10px;height:10px;border-radius:2px;background:#CDBCAF;display:inline-block;" aria-hidden="true"></span>Principal</span>
              <span style="display:inline-flex;align-items:center;gap:6px;"><span style="width:10px;height:10px;border-radius:2px;background:#EF4130;display:inline-block;" aria-hidden="true"></span>Interest</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ═══════════ 2. EXTRA REPAYMENTS CALCULATOR ═══════════ -->
    <div id="extra" style="margin-bottom:clamp(44px,5.5vw,72px);">
      <div style="max-width:680px;margin-bottom:22px;">
        <div style="font-size:12.5px;font-weight:600;letter-spacing:0.16em;text-transform:uppercase;color:#EF4130;margin-bottom:12px;">Calculator 02</div>
        <h2 style="font-weight:800;font-size:clamp(1.7rem,3vw,2.4rem);line-height:1.08;letter-spacing:-0.02em;color:#40242C;margin:0 0 10px;">Extra repayments calculator</h2>
        <p style="font-size:15.5px;line-height:1.6;color:#6E6258;margin:0;">Small extra payments compound. See how much interest and how many years a regular top-up, or a one-off lump sum, could take off your loan.</p>
      </div>
      <div class="calc-card">
        <div>
          <div class="calc-field"><label class="calc-label" for="e-amount">Loan amount ($)</label><input class="calc-input" type="number" id="e-amount" inputmode="decimal" min="0" step="1000" value="600000"></div>
          <div class="calc-field"><label class="calc-label" for="e-rate">Interest rate (% p.a.)</label><input class="calc-input" type="number" id="e-rate" inputmode="decimal" min="0" max="25" step="0.01" value="5.50"></div>
          <div class="calc-field"><label class="calc-label" for="e-term">Loan term (years)</label><input class="calc-input" type="number" id="e-term" inputmode="numeric" min="1" max="35" step="1" value="30"></div>
          <div class="calc-field"><label class="calc-label" for="e-freq">Repayment frequency</label><select class="calc-input" id="e-freq"><option value="52">Weekly</option><option value="26" selected>Fortnightly</option><option value="12">Monthly</option></select></div>
          <div class="calc-field"><label class="calc-label" for="e-extra">Extra payment each period ($)</label><input class="calc-input" type="number" id="e-extra" inputmode="decimal" min="0" step="10" value="100"></div>
          <div class="calc-field"><label class="calc-label" for="e-lump">One-off lump sum today ($)</label><input class="calc-input" type="number" id="e-lump" inputmode="decimal" min="0" step="500" value="0"><p class="calc-hint">Fixed-rate loans usually cap extra repayments; break fees can apply. We can check your loan's rules.</p></div>
        </div>
        <div class="result-panel">
          <div class="result-row"><p class="result-label">Interest saved</p><p class="result-big result-accent" id="e-saved">$0</p></div>
          <div class="result-row"><p class="result-label">Time taken off the loan</p><p class="result-mid" id="e-time">0 years</p></div>
          <div class="result-row"><p class="result-label">Loan paid off in</p><p class="result-mid" id="e-payoff">0 years</p></div>
          <div class="result-row"><p class="result-label">Standard repayment → your repayment</p><p class="result-mid" id="e-payments">$0 → $0</p></div>
          <div class="result-row">
            <p class="result-label">Loan balance over time</p>
            <svg viewBox="0 0 300 150" width="100%" aria-hidden="true" style="display:block;margin-top:6px;">
              <line x1="36" y1="10" x2="36" y2="126" stroke="rgba(255,255,255,0.25)" stroke-width="1"/>
              <line x1="36" y1="126" x2="292" y2="126" stroke="rgba(255,255,255,0.25)" stroke-width="1"/>
              <polyline id="e-line-base" fill="none" stroke="#CDBCAF" stroke-width="2.5" stroke-linejoin="round" points=""/>
              <polyline id="e-line-extra" fill="none" stroke="#EF4130" stroke-width="2.5" stroke-linejoin="round" points=""/>
              <text x="36" y="140" text-anchor="start" fill="rgba(255,255,255,0.55)" font-size="9">0</text>
              <text id="e-x-max" x="292" y="140" text-anchor="end" fill="rgba(255,255,255,0.55)" font-size="9"></text>
              <text id="e-y-max" x="32" y="16" text-anchor="end" fill="rgba(255,255,255,0.55)" font-size="9"></text>
              <text x="32" y="129" text-anchor="end" fill="rgba(255,255,255,0.55)" font-size="9">$0</text>
            </svg>
            <div style="display:flex;justify-content:center;gap:18px;font-size:12px;color:rgba(255,255,255,0.7);margin-top:2px;">
              <span style="display:inline-flex;align-items:center;gap:6px;"><span style="width:10px;height:10px;border-radius:2px;background:#CDBCAF;display:inline-block;" aria-hidden="true"></span>Standard</span>
              <span style="display:inline-flex;align-items:center;gap:6px;"><span style="width:10px;height:10px;border-radius:2px;background:#EF4130;display:inline-block;" aria-hidden="true"></span>With extras</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ═══════════ 3. REFIX / REFINANCE COMPARISON ═══════════ -->
    <div id="refix" style="margin-bottom:clamp(44px,5.5vw,72px);">
      <div style="max-width:680px;margin-bottom:22px;">
        <div style="font-size:12.5px;font-weight:600;letter-spacing:0.16em;text-transform:uppercase;color:#EF4130;margin-bottom:12px;">Calculator 03</div>
        <h2 style="font-weight:800;font-size:clamp(1.7rem,3vw,2.4rem);line-height:1.08;letter-spacing:-0.02em;color:#40242C;margin:0 0 10px;">Refix &amp; refinance comparison</h2>
        <p style="font-size:15.5px;line-height:1.6;color:#6E6258;margin:0;">Fixed rate coming up for renewal? Compare two rates side by side and see the difference per payment and over the remaining term.</p>
      </div>
      <div class="calc-card">
        <div>
          <div class="calc-field"><label class="calc-label" for="f-amount">Loan balance ($)</label><input class="calc-input" type="number" id="f-amount" inputmode="decimal" min="0" step="1000" value="500000"></div>
          <div class="calc-field"><label class="calc-label" for="f-term">Remaining term (years)</label><input class="calc-input" type="number" id="f-term" inputmode="numeric" min="1" max="35" step="1" value="25"></div>
          <div class="calc-field"><label class="calc-label" for="f-rate1">Rate A (% p.a.)</label><input class="calc-input" type="number" id="f-rate1" inputmode="decimal" min="0" max="25" step="0.01" value="6.50"><p class="calc-hint">For example, your current or offered rate.</p></div>
          <div class="calc-field"><label class="calc-label" for="f-rate2">Rate B (% p.a.)</label><input class="calc-input" type="number" id="f-rate2" inputmode="decimal" min="0" max="25" step="0.01" value="5.50"><p class="calc-hint">For example, a rate you're comparing.</p></div>
          <div class="calc-field"><label class="calc-label" for="f-freq">Repayment frequency</label><select class="calc-input" id="f-freq"><option value="52">Weekly</option><option value="26" selected>Fortnightly</option><option value="12">Monthly</option></select></div>
        </div>
        <div class="result-panel">
          <div class="result-row"><p class="result-label">Repayment at Rate A</p><p class="result-mid" id="f-pay1">$0</p></div>
